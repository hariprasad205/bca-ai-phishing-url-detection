# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production

# MySQL Database Configuration (Mandatory Relational Database)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=phishing_detection_db
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/phishing_detection_db

# File Storage & Uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
UPLOAD_FOLDER=data/uploads
MODELS_FOLDER=models_storage

# ML Training & Selection Thresholds
MIN_MODEL_RECALL=0.80
MAX_LATENCY_MS=100.0
SCORE_WEIGHT_RECALL=0.40
SCORE_WEIGHT_F1=0.30
SCORE_WEIGHT_PRECISION=0.20
SCORE_WEIGHT_SPEED=0.10

# Security & Rate Limiting
RATELIMIT_DEFAULT=200/hour
RATELIMIT_AUTH=15/minute
RATELIMIT_SCAN=60/minute
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
